# ============================================
# TMS SARL - SECURITY HEADERS
# ============================================

# Toutes les pages
/* 
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com 'unsafe-inline'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';
  Permissions-Policy: geolocation=(), microphone=(), camera=()
/

# Pages HTML (cache court)
/*.html
  Cache-Control: public, max-age=3600
/

# Images (cache long)
*.jpg
*.jpeg
*.png
*.gif
*.svg
*.webp
  Cache-Control: public, max-age=31536000, immutable
/

# CSS & JS (cache long)
*.css
*.js
  Cache-Control: public, max-age=31536000, immutable
/

# Fonts (cache long)
*.woff
*.woff2
*.ttf
  Cache-Control: public, max-age=31536000, immutable
/